{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
        "cwd": "apps/mobile"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @open-support/mobile run dev"
      }
    }
  },
  "tags": ["scope:mobile", "type:app"]
}
