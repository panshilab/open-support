{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.build.json",
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/oxlint --ignore-path ../../.gitignore .",
        "cwd": "apps/api"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/oxfmt --check --ignore-path ../../.gitignore .",
        "cwd": "apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @open-support/api run dev"
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}
