NODE_ENV=development
APP_NAME="Open Support"
APP_URL=http://localhost:7000
API_HOST=0.0.0.0
API_PORT=7001
# Optional, comma-separated. If missing, defaults to APP_URL.
CORS_ORIGINS=http://localhost:7000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=open_support
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Optional. If missing, the API uses in-memory cache.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_DEFAULT_TTL_SECONDS=300

SESSION_SECRET=change-this-session-secret-before-production
SESSION_COOKIE_NAME=open_support_session
SESSION_TTL_SECONDS=604800
ADMIN_EMAILS=admin@example.com

OTP_EXPIRES_IN_SECONDS=600
OTP_LENGTH=6

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME="Open Support"

GOOGLE_CLIENT_ID=

# Optional. If missing, knowledgebase uses regular PostgreSQL text search.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional. When configured, unhandled server errors are sent to Sentry.
SENTRY_DSN=
# Optional. Sends server errors to a Slack Incoming Webhook.
SLACK_ERROR_WEBHOOK_URL=

MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=uploads/media
MEDIA_PUBLIC_URL=http://localhost:7001/uploads/media
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=media

GOOGLE_CLIENT_ID=102743454683-gol289342hj54b5jf2f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=DFGESPX-31jKaK1jwfhzs0
