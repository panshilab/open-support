{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/vite build",
        "cwd": "apps/web"
      },
      "outputs": ["{projectRoot}/.output", "{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
        "cwd": "apps/web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @open-support/web run dev"
      }
    }
  },
  "tags": ["scope:frontend", "type:app"]
}
