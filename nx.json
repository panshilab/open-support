{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "useInferencePlugins": false,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.test.ts"]
  },
  "targetDefaults": {
    "serve": {
      "dependsOn": ["^build"]
    },
    "build": {
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "format:check": {
      "inputs": ["default"],
      "cache": true
    }
  }
}
