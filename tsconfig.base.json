{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@open-support/schemas": ["packages/schemas/src/index.ts"],
      "@open-support/schemas/base": ["packages/schemas/src/base/index.ts"],
      "@open-support/schemas/backend": ["packages/schemas/src/backend/index.ts"],
      "@open-support/schemas/frontend": ["packages/schemas/src/frontend/index.ts"],
      "@open-support/schemas/types": ["packages/schemas/src/types/index.ts"],
      "@open-support/schemas/ai": ["packages/schemas/src/ai/index.ts"],
      "@open-support/schemas/assistant": ["packages/schemas/src/assistant/index.ts"],
      "@open-support/schemas/auth": ["packages/schemas/src/auth/index.ts"],
      "@open-support/schemas/category": ["packages/schemas/src/category/index.ts"],
      "@open-support/schemas/chat": ["packages/schemas/src/chat/index.ts"],
      "@open-support/schemas/dashboard": ["packages/schemas/src/dashboard/index.ts"],
      "@open-support/schemas/knowledge-base": ["packages/schemas/src/knowledge-base/index.ts"],
      "@open-support/schemas/media": ["packages/schemas/src/media/index.ts"],
      "@open-support/schemas/ticket": ["packages/schemas/src/ticket/index.ts"],
      "@open-support/schemas/user": ["packages/schemas/src/user/index.ts"],
      "@open-support/services": ["packages/services/src/index.ts"],
      "@open-support/services/axios": ["packages/services/src/axios.ts"]
