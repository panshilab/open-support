{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@open-support/schemas": ["packages/services/node_modules/@open-support/schemas"],
      "@open-support/schemas/*": ["packages/services/node_modules/@open-support/schemas/*"]
    },
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
