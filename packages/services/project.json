{
  "name": "services",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/services/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.json",
        "cwd": "packages/services"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
        "cwd": "packages/services"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/oxlint --ignore-path ../../.gitignore .",
        "cwd": "packages/services"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/oxfmt --check --ignore-path ../../.gitignore .",
        "cwd": "packages/services"
      }
    }
  },
  "tags": ["scope:shared", "type:service"]
}
